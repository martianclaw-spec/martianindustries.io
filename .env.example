# Required for the /api/audit form submission route.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Sender used for the audit email.
# Resend requires this address to be on a domain you have verified
# in https://resend.com/domains. Until martianindustries.io is verified
# (add SPF + DKIM records to Porkbun), leave this blank and the route
# will fall back to Resend's shared sandbox sender (onboarding@resend.dev).
#
# Once verified, set to something like:
#   RESEND_FROM_EMAIL="Martian Industries <audit@martianindustries.io>"
RESEND_FROM_EMAIL=
