# Required for the /api/audit form submission route.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Sender used for the audit email.
# Resend requires this address to be on a domain you have verified
# in https://resend.com/domains. Until martianindustries.io is verified
# (add SPF + DKIM records to Porkbun), leave this blank and the route
# will fall back to Resend's shared sandbox sender (onboarding@resend.dev).
#
# Once verified, set to something like:
#   RESEND_FROM_EMAIL="Martian Industries <audit@martianindustries.io>"
RESEND_FROM_EMAIL=

# Optional. Recipient for audit form submissions. Defaults to
# hello@martianindustries.io.
#
# IMPORTANT: while running in Resend sandbox mode (RESEND_FROM_EMAIL
# blank), Resend will ONLY deliver to the email address that owns your
# Resend account. If your Resend account is on martianclaw@gmail.com,
# set RESEND_TO_EMAIL to that Gmail here or the form will silently fail.
# Once you verify a domain in Resend and set RESEND_FROM_EMAIL, you can
# point RESEND_TO_EMAIL at any real inbox (hello@martianindustries.io,
# a Google Workspace mailbox, whatever).
RESEND_TO_EMAIL=
